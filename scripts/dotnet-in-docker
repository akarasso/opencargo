#!/usr/bin/env bash
set -euo pipefail
image=mcr.microsoft.com/dotnet/sdk:8.0@sha256:5ef85cc12cb25be6ec319a7392d1e9efd53c3bc8abb971c53d8058a473f09053
tmp=${TMPDIR:-/tmp}
exec docker run --rm -i --network host -u "$(id -u):$(id -g)" \
  -e HOME -e NUGET_PACKAGES -e SSL_CERT_FILE -e DOTNET_CLI_HOME="${HOME:-/tmp}" \
  -e DOTNET_NOLOGO=1 -e DOTNET_CLI_TELEMETRY_OPTOUT=1 -e DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
  -v "$tmp:$tmp" -v "$PWD:$PWD" -w "$PWD" "$image" dotnet "$@"
