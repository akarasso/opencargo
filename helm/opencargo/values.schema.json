{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "One instance per database: a second pod refuses to start on the writer lease."
    },
    "lease": {
      "type": "object",
      "properties": {
        "waitSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "startup": {
      "type": "object",
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
